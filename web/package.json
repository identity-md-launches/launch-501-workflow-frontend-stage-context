{
  "name": "swarm-cities-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/export.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tests/swap-unit.mjs && node tests/interactions.mjs",
    "verify": "node scripts/verify.mjs",
    "check:live": "node scripts/check-live.mjs && node tests/swap-network.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.37.3"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "playwright": "1.55.1"
  }
}
